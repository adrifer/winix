// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`cross-platform example (docs/guides) > generates stable Nix output (replaces the old reference example snapshot) 1`] = `
{
  "flake.nix": "# Generated by Winix — do not edit
{
  description = "Generated by Winix";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    home-manager.url = "github:nix-community/home-manager";
    home-manager.inputs.nixpkgs.follows = "nixpkgs";
    nix-darwin.url = "github:nix-darwin/nix-darwin";
    nix-darwin.inputs.nixpkgs.follows = "nixpkgs";
    nixos-wsl.url = "github:nix-community/NixOS-WSL";
    nixos-wsl.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = { self, nixpkgs, ... } @ inputs: {
    nixosConfigurations.wsl-work = nixpkgs.lib.nixosSystem {
      system = "x86_64-linux";
      modules = [ ./hosts/wsl-work.nix ];
      specialArgs = { inherit inputs; };
    };

    darwinConfigurations.macbook = inputs.nix-darwin.lib.darwinSystem {
      system = "aarch64-darwin";
      modules = [ ./hosts/macbook.nix ];
      specialArgs = { inherit inputs; };
    };
  };
}
",
  "hosts/macbook.nix": "# Generated by Winix — do not edit
{ config, lib, pkgs, inputs, ... }:

{
  imports = [
    inputs.home-manager.darwinModules.home-manager
  ];

  nixpkgs.hostPlatform = "aarch64-darwin";
  nixpkgs.config.allowUnfree = true;
  nix.enable = false;
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
  networking.hostName = "macbook";
  system.stateVersion = 6;
  system.primaryUser = "alice";
  home-manager.useGlobalPkgs = true;
  home-manager.useUserPackages = true;
  users.users.alice.home = "/Users/alice";
  users.users.alice.shell = pkgs.zsh;
  environment.shells = [ pkgs.zsh ];
  programs.zsh.enable = true;

  # Home Manager
  home-manager.users.alice = { config, lib, pkgs, ... }: {
    home.username = "alice";
    home.homeDirectory = "/Users/alice";
    home.stateVersion = "25.05";
    home.packages = with pkgs; [ lazygit ];
    home.file."Library/Application Support/lazygit/config.yml".source = config.lib.file.mkOutOfStoreSymlink "<example>/dotfiles/lazygit/config.yml";
    programs.home-manager.enable = true;
    programs.zsh.enable = true;
    programs.zsh.shellAliases.g = "lazygit";
    programs.zsh.shellAliases.gs = "git status";
    programs.zsh.shellAliases.".." = "cd ..";
    programs.starship.enable = true;
    programs.git.enable = true;
    programs.git.settings.init.defaultBranch = "main";
    programs.git.settings.user.name = "Alice Example";
    programs.git.settings.user.email = "alice@example.com";
    programs.git.settings.pull.rebase = true;
    programs.git.settings.alias.lg = "log --graph --oneline --decorate";
    programs.git.includes = [ { condition = "gitdir:~/work/"; contents.user.email = "alice@work.example"; } ];
    xdg.configFile."starship.toml".source = config.lib.file.mkOutOfStoreSymlink "<example>/dotfiles/starship/starship.toml";
  };
}
",
  "hosts/wsl-work.nix": "# Generated by Winix — do not edit
{ config, lib, pkgs, inputs, ... }:

{
  imports = [
    inputs.home-manager.nixosModules.home-manager
    inputs.nixos-wsl.nixosModules.wsl
  ];

  nixpkgs.hostPlatform = "x86_64-linux";
  nixpkgs.config.allowUnfree = true;
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
  networking.hostName = "wsl-work";
  system.stateVersion = "25.05";
  wsl.enable = true;
  wsl.defaultUser = lib.mkDefault "alice";
  users.users.alice.isNormalUser = true;
  users.users.alice.extraGroups = [ "wheel" ];
  users.users.alice.shell = pkgs.zsh;
  users.defaultUserShell = pkgs.zsh;
  programs.zsh.enable = true;

  home-manager.useGlobalPkgs = true;
  home-manager.useUserPackages = true;

  # Home Manager
  home-manager.users.alice = { config, lib, pkgs, ... }: {
    home.username = "alice";
    home.homeDirectory = "/home/alice";
    home.stateVersion = "25.05";
    home.packages = with pkgs; [ lazygit nodejs_24 (pkgs.writeShellScriptBin "code" ''
wslpath=/bin/wslpath
[ -x "$wslpath" ] || wslpath=$(command -v wslpath) || { echo 'code: wslpath not found; this shim only works inside WSL' >&2; exit 127; }
cmd=$("$wslpath" -u 'C:\\Windows\\System32\\cmd.exe' 2>/dev/null)
resolve() {
  local win=$1
  case "$win" in
    *%*)
      [ -n "$cmd" ] && [ -x "$cmd" ] || return 1
      win=$(cd "''\${cmd%/*}" && "$cmd" /d /c "echo $win" </dev/null 2>/dev/null) || return 1
      win=''\${win%$'\\r'}
      case "$win" in *%*) return 1 ;; esac
      ;;
  esac
  "$wslpath" -u "$win" 2>/dev/null
}
for candidate in '%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\bin\\code'; do
  if target=$(resolve "$candidate") && [ -n "$target" ] && [ -f "$target" ]; then
    exec "$target" "$@"
  fi
done
echo 'code: Windows executable not found at: %LOCALAPPDATA%\\Programs\\Microsoft VS Code\\bin\\code' >&2
exit 127
'') ];
    programs.home-manager.enable = true;
    programs.zsh.enable = true;
    programs.zsh.shellAliases.g = "lazygit";
    programs.zsh.shellAliases.gs = "git status";
    programs.zsh.shellAliases.".." = "cd ..";
    programs.starship.enable = true;
    programs.git.enable = true;
    programs.git.settings.init.defaultBranch = "main";
    programs.git.settings.user.name = "Alice Example";
    programs.git.settings.user.email = "alice@example.com";
    programs.git.settings.pull.rebase = true;
    programs.git.settings.alias.lg = "log --graph --oneline --decorate";
    programs.git.settings.credential.helper = "\${(pkgs.writeShellScriptBin "git-credential-manager" ''
wslpath=/bin/wslpath
[ -x "$wslpath" ] || wslpath=$(command -v wslpath) || { echo 'git-credential-manager: wslpath not found; this shim only works inside WSL' >&2; exit 127; }
cmd=$("$wslpath" -u 'C:\\Windows\\System32\\cmd.exe' 2>/dev/null)
resolve() {
  local win=$1
  case "$win" in
    *%*)
      [ -n "$cmd" ] && [ -x "$cmd" ] || return 1
      win=$(cd "''\${cmd%/*}" && "$cmd" /d /c "echo $win" </dev/null 2>/dev/null) || return 1
      win=''\${win%$'\\r'}
      case "$win" in *%*) return 1 ;; esac
      ;;
  esac
  "$wslpath" -u "$win" 2>/dev/null
}
for candidate in '%ProgramFiles%\\Git\\ucrt64\\bin\\git-credential-manager.exe' '%ProgramFiles%\\Git\\mingw64\\bin\\git-credential-manager.exe'; do
  if target=$(resolve "$candidate") && [ -n "$target" ] && [ -f "$target" ]; then
    exec "$target" "$@"
  fi
done
echo 'git-credential-manager: Windows executable not found at: %ProgramFiles%\\Git\\ucrt64\\bin\\git-credential-manager.exe, %ProgramFiles%\\Git\\mingw64\\bin\\git-credential-manager.exe' >&2
exit 127
'')}/bin/git-credential-manager";
    programs.git.includes = [ { condition = "gitdir:~/work/"; contents.user.email = "alice@work.example"; } ];
    xdg.configFile."starship.toml".source = config.lib.file.mkOutOfStoreSymlink "<example>/dotfiles/starship/starship.toml";
    xdg.configFile."lazygit/config.yml".source = config.lib.file.mkOutOfStoreSymlink "<example>/dotfiles/lazygit/config.yml";
  };
}
",
}
`;
