// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`reference example integration > generates stable Nix output for examples/reference 1`] = `
{
  "flake.nix": "# Generated by Winix — do not edit
{
  description = "Generated by Winix";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    nixpkgs-stable.url = "github:NixOS/nixpkgs/nixos-25.11";
    home-manager.url = "github:nix-community/home-manager";
    home-manager.inputs.nixpkgs.follows = "nixpkgs";
    home-manager-stable.url = "github:nix-community/home-manager/release-25.11";
    home-manager-stable.inputs.nixpkgs.follows = "nixpkgs-stable";
    nix-darwin.url = "github:nix-darwin/nix-darwin";
    nix-darwin.inputs.nixpkgs.follows = "nixpkgs";
    nix-homebrew.url = "github:zhaofengli/nix-homebrew";
    nixos-wsl.url = "github:nix-community/NixOS-WSL";
    nixos-wsl.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = { self, nixpkgs, ... } @ inputs: {
    nixosConfigurations.wsl = nixpkgs.lib.nixosSystem {
      system = "x86_64-linux";
      modules = [ ./hosts/wsl.nix ];
      specialArgs = { inherit inputs; };
    };

    darwinConfigurations.macbook-pro = inputs.nix-darwin.lib.darwinSystem {
      system = "aarch64-darwin";
      modules = [ ./hosts/macbook-pro.nix ];
      specialArgs = { inherit inputs; };
    };
  };
}
",
  "hosts/macbook-pro.nix": "# Generated by Winix — do not edit
{ config, lib, pkgs, inputs, ... }:

{
  imports = [
    inputs.home-manager.darwinModules.home-manager
    inputs.nix-homebrew.darwinModules.nix-homebrew
  ];

  nixpkgs.hostPlatform = "aarch64-darwin";
  nixpkgs.config.allowUnfree = true;
  nixpkgs.overlays = [ (final: prev: { stable = import inputs.nixpkgs-stable { inherit (final.stdenv.hostPlatform) system; config = final.config.nixpkgs.config or {}; }; }) ];
  nix.enable = false;
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
  networking.hostName = "macbook-pro";
  system.stateVersion = 6;
  system.primaryUser = "tony";
  home-manager.useGlobalPkgs = true;
  home-manager.useUserPackages = true;
  nix-homebrew.enable = true;
  nix-homebrew.autoMigrate = true;
  nix-homebrew.user = "tony";
  homebrew.enable = true;
  homebrew.casks = [ "scroll-reverser" "visual-studio-code" ];
  security.pam.services.sudo_local.touchIdAuth = true;
  users.users.tony.home = "/Users/tony";
  users.users.tony.shell = pkgs.zsh;
  environment.shells = [ pkgs.zsh ];
  programs.zsh.enable = true;

  # Home Manager
  home-manager.users.tony = { config, lib, pkgs, ... }: {
    manual.manpages.enable = false;
    home.username = "tony";
    home.homeDirectory = "/Users/tony";
    home.stateVersion = "25.05";
    home.packages = with pkgs; [ nerd-fonts.jetbrains-mono wget curl eza bat tree fastfetch unzip yazi ripgrep fd jq openssl lazygit gh mkcert nixfmt nixd python3 gnumake bun nodejs_22 pnpm neovim ];
    home.sessionVariables.NPM_CONFIG_PREFIX = "\${config.home.homeDirectory}/.npm-global";
    home.sessionVariables.NPM_CONFIG_USERCONFIG = "\${config.home.homeDirectory}/.config/npm/npmrc";
    home.sessionVariables.PNPM_HOME = "\${config.home.homeDirectory}/.local/share/pnpm";
    home.sessionVariables.EDITOR = "nvim";
    home.sessionPath = [ "\${config.home.homeDirectory}/.npm-global/bin" "\${config.home.homeDirectory}/.local/share/pnpm" ];
    home.activation.ensureWritableNpmrc = lib.hm.dag.entryAfter [ "writeBoundary" ] ''

      mkdir -p "\${config.home.homeDirectory}/.config/npm"
      touch "\${config.home.homeDirectory}/.config/npm/npmrc"
      chmod 600 "\${config.home.homeDirectory}/.config/npm/npmrc"
    
'';
    programs.home-manager.enable = true;
    programs.zsh.enable = true;
    programs.zsh.autosuggestion.enable = true;
    programs.zsh.enableCompletion = true;
    programs.zsh.syntaxHighlighting.enable = true;
    programs.zsh.plugins = [ { name = "zsh-vi-mode"; src = pkgs.zsh-vi-mode; file = "share/zsh-vi-mode/zsh-vi-mode.plugin.zsh"; } ];
    programs.zsh.shellAliases.ls = "eza -lh --group-directories-first --icons=auto";
    programs.zsh.shellAliases.lsa = "ls -a";
    programs.zsh.shellAliases.lt = "eza --tree --level=2 --long --icons --git";
    programs.zsh.shellAliases.lt3 = "lt --level=3";
    programs.zsh.shellAliases.lta = "lt -a";
    programs.zsh.shellAliases.grep = "grep --color=auto";
    programs.zsh.shellAliases.g = "lazygit";
    programs.zsh.shellAliases.lg = "lazygit";
    programs.zsh.shellAliases.cd = "zd";
    programs.zsh.shellAliases.n = "nvim";
    programs.zsh.shellAliases.ta = "tmux attach-session";
    programs.zsh.shellAliases.".." = "cd ..";
    programs.zsh.shellAliases."..." = "cd ../..";
    programs.zsh.shellAliases.i = "cd ~/dotfiles/winix && npx winix apply && sudo darwin-rebuild switch --flake path:$PWD/.winix/out#macbook-pro";
    programs.zsh.shellAliases.u = "cd ~/dotfiles/winix/.winix/out && nix flake update && sudo darwin-rebuild switch --flake path:$PWD#macbook-pro";
    programs.zsh.shellAliases.gc = "nix-collect-garbage -d";
    programs.zsh.initContent = ''
    export ZVM_VI_INSERT_ESCAPE_BINDKEY=jj

    y() {
      local tmp cwd
      tmp="$(mktemp -t yazi-cwd.XXXXXX)"
      yazi "$@" --cwd-file="$tmp"
      if cwd="$(command cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
        builtin cd -- "$cwd"
      fi
      rm -f -- "$tmp"
    }

    zd() {
      if [ $# -eq 0 ]; then
        builtin cd ~ && return
      elif [ -d "$1" ]; then
        builtin cd "$1"
      else
        z "$@" && pwd || echo "Error: Directory not found"
      fi
    }
'';
    programs.starship.enable = true;
    programs.starship.enableZshIntegration = true;
    programs.starship.settings.add_newline = false;
    programs.starship.settings.format = "$directory$character";
    programs.starship.settings.right_format = "$all";
    programs.starship.settings.character.vicmd_symbol = "[N](bold green)";
    programs.starship.settings.git_branch.format = "[$symbol$branch(:$remote_branch)](fg:4) ";
    programs.starship.settings.docker_context.disabled = true;
    programs.starship.settings.bun.disabled = true;
    programs.starship.settings.nodejs.detect_files = [ "package.json" ".node-version" "!bunfig.toml" "!bun.lockb" ];
    programs.fzf.enable = true;
    programs.fzf.enableZshIntegration = true;
    programs.zoxide.enable = true;
    programs.zoxide.enableZshIntegration = true;
    programs.git.enable = true;
    programs.git.settings.user.name = "Tony Stark";
    programs.git.settings.user.email = "tony@stark.industries";
    programs.git.settings.diff.tool = "nvimdiff";
    programs.git.settings.difftool.prompt = false;
    programs.git.includes = [ { condition = "gitdir:~/projects/oss/"; contents.user.name = "Tony Stark"; contents.user.email = "tony@oss.example"; } ];
    xdg.configFile.nvim.source = config.lib.file.mkOutOfStoreSymlink "\${config.home.homeDirectory}/dotfiles/nvim/.config/nvim";
    xdg.configFile.nvim.recursive = true;
    xdg.configFile.eza.source = config.lib.file.mkOutOfStoreSymlink "\${config.home.homeDirectory}/dotfiles/eza/.config/eza";
    xdg.configFile.eza.recursive = true;
    xdg.configFile.lazygit.source = config.lib.file.mkOutOfStoreSymlink "\${config.home.homeDirectory}/dotfiles/lazygit/.config/lazygit";
    xdg.configFile.lazygit.recursive = true;
    xdg.configFile.yazi.source = config.lib.file.mkOutOfStoreSymlink "\${config.home.homeDirectory}/dotfiles/yazi/.config/yazi";
    xdg.configFile.yazi.recursive = true;
    xdg.configFile.ghostty.source = config.lib.file.mkOutOfStoreSymlink "\${config.home.homeDirectory}/dotfiles/ghostty/.config/ghostty";
    xdg.configFile.ghostty.recursive = true;
  };
}
",
  "hosts/wsl.nix": "# Generated by Winix — do not edit
{ config, lib, pkgs, inputs, ... }:

{
  imports = [
    inputs.home-manager.nixosModules.home-manager
    inputs.nixos-wsl.nixosModules.wsl
  ];

  nixpkgs.hostPlatform = "x86_64-linux";
  nixpkgs.config.allowUnfree = true;
  nixpkgs.overlays = [ (final: prev: { stable = import inputs.nixpkgs-stable { inherit (final.stdenv.hostPlatform) system; config = final.config.nixpkgs.config or {}; }; }) ];
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
  networking.hostName = "wsl";
  system.stateVersion = "25.05";
  users.users.tony.isNormalUser = true;
  users.users.tony.extraGroups = [ "wheel" ];
  users.users.tony.shell = pkgs.zsh;
  users.defaultUserShell = pkgs.zsh;
  programs.zsh.enable = true;
  programs.nix-ld.enable = true;
  programs.nix-ld.libraries = with pkgs; [ icu zlib openssl ];
  wsl.defaultUser = lib.mkDefault "tony";
  wsl.enable = true;
  wsl.wslConf.interop.enabled = true;
  wsl.wslConf.interop.appendWindowsPath = false;
  wsl.interop.register = true;
  wsl.extraBin = [ { src = "\${pkgs.coreutils}/bin/mkdir"; } { src = "\${pkgs.coreutils}/bin/cat"; } { src = "\${pkgs.coreutils}/bin/whoami"; } { src = "\${pkgs.coreutils}/bin/ls"; } { src = "\${pkgs.busybox}/bin/addgroup"; } { src = "\${pkgs.su}/bin/groupadd"; } { src = "\${pkgs.su}/bin/usermod"; } ];
  environment.interactiveShellInit = ''
        win_home="$(wslpath -w "$HOME")"
        win_home_slash="''\${win_home//\\\\//}"
        win_user="''\${win_home_slash##*/}"

        user_bin="/mnt/c/Users/$win_user/AppData/Local/Programs/Microsoft VS Code Insiders/bin"
        if [ -d "$user_bin" ]; then
          case ":$PATH:" in
            *":$user_bin:"*) ;;
            *) PATH="$PATH:$user_bin" ;;
          esac
        fi

        export PATH
'';
  environment.systemPackages = with pkgs; [ wl-clipboard ];

  home-manager.useGlobalPkgs = true;
  home-manager.useUserPackages = true;

  # Home Manager
  home-manager.users.tony = { config, lib, pkgs, ... }: {
    home.username = "tony";
    home.homeDirectory = "/home/tony";
    home.stateVersion = "25.05";
    home.packages = with pkgs; [ gcc wget curl eza bat tree fastfetch unzip yazi ripgrep fd jq openssl lazygit gh mkcert nixfmt nixd python3 gnumake bun nodejs_22 pnpm neovim pkgs.stable.wslu chromium ];
    home.sessionVariables.NPM_CONFIG_PREFIX = "\${config.home.homeDirectory}/.npm-global";
    home.sessionVariables.NPM_CONFIG_USERCONFIG = "\${config.home.homeDirectory}/.config/npm/npmrc";
    home.sessionVariables.PNPM_HOME = "\${config.home.homeDirectory}/.local/share/pnpm";
    home.sessionVariables.EDITOR = "nvim";
    home.sessionVariables.PLAYWRIGHT_CHROMIUM_EXECUTABLE = "\${pkgs.chromium}/bin/chromium";
    home.sessionVariables.PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS = "true";
    home.sessionVariables.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD = "1";
    home.sessionPath = [ "\${config.home.homeDirectory}/.npm-global/bin" "\${config.home.homeDirectory}/.local/share/pnpm" ];
    home.activation.ensureWritableNpmrc = lib.hm.dag.entryAfter [ "writeBoundary" ] ''

      mkdir -p "\${config.home.homeDirectory}/.config/npm"
      touch "\${config.home.homeDirectory}/.config/npm/npmrc"
      chmod 600 "\${config.home.homeDirectory}/.config/npm/npmrc"
    
'';
    programs.home-manager.enable = true;
    programs.zsh.enable = true;
    programs.zsh.autosuggestion.enable = true;
    programs.zsh.enableCompletion = true;
    programs.zsh.syntaxHighlighting.enable = true;
    programs.zsh.plugins = [ { name = "zsh-vi-mode"; src = pkgs.zsh-vi-mode; file = "share/zsh-vi-mode/zsh-vi-mode.plugin.zsh"; } ];
    programs.zsh.shellAliases.ls = "eza -lh --group-directories-first --icons=auto";
    programs.zsh.shellAliases.lsa = "ls -a";
    programs.zsh.shellAliases.lt = "eza --tree --level=2 --long --icons --git";
    programs.zsh.shellAliases.lt3 = "lt --level=3";
    programs.zsh.shellAliases.lta = "lt -a";
    programs.zsh.shellAliases.grep = "grep --color=auto";
    programs.zsh.shellAliases.g = "lazygit";
    programs.zsh.shellAliases.lg = "lazygit";
    programs.zsh.shellAliases.cd = "zd";
    programs.zsh.shellAliases.n = "nvim";
    programs.zsh.shellAliases.ta = "tmux attach-session";
    programs.zsh.shellAliases.".." = "cd ..";
    programs.zsh.shellAliases."..." = "cd ../..";
    programs.zsh.shellAliases.i = "cd ~/dotfiles/winix && npx winix apply && sudo nixos-rebuild switch --flake path:$PWD/.winix/out";
    programs.zsh.shellAliases.u = "cd ~/dotfiles/winix/.winix/out && nix flake update && sudo nixos-rebuild switch --flake path:$PWD";
    programs.zsh.shellAliases.gc = "sudo nix-collect-garbage -d";
    programs.zsh.initContent = ''
    export ZVM_VI_INSERT_ESCAPE_BINDKEY=jj

    y() {
      local tmp cwd
      tmp="$(mktemp -t yazi-cwd.XXXXXX)"
      yazi "$@" --cwd-file="$tmp"
      if cwd="$(command cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
        builtin cd -- "$cwd"
      fi
      rm -f -- "$tmp"
    }

    zd() {
      if [ $# -eq 0 ]; then
        builtin cd ~ && return
      elif [ -d "$1" ]; then
        builtin cd "$1"
      else
        z "$@" && pwd || echo "Error: Directory not found"
      fi
    }
'' + ''
        export BROWSER=wslview

        keep_current_path() {
          printf "\\e]9;9;%s\\e\\\\" "$(wslpath -w "$PWD")"
        }
        precmd_functions+=(keep_current_path)
'';
    programs.starship.enable = true;
    programs.starship.enableZshIntegration = true;
    programs.starship.settings.add_newline = false;
    programs.starship.settings.format = "$directory$character";
    programs.starship.settings.right_format = "$all";
    programs.starship.settings.character.vicmd_symbol = "[N](bold green)";
    programs.starship.settings.git_branch.format = "[$symbol$branch(:$remote_branch)](fg:4) ";
    programs.starship.settings.docker_context.disabled = true;
    programs.starship.settings.bun.disabled = true;
    programs.starship.settings.nodejs.detect_files = [ "package.json" ".node-version" "!bunfig.toml" "!bun.lockb" ];
    programs.fzf.enable = true;
    programs.fzf.enableZshIntegration = true;
    programs.zoxide.enable = true;
    programs.zoxide.enableZshIntegration = true;
    programs.git.enable = true;
    programs.git.settings.user.name = "Tony Stark";
    programs.git.settings.user.email = "tony@stark.industries";
    programs.git.settings.diff.tool = "nvimdiff";
    programs.git.settings.difftool.prompt = false;
    programs.git.settings.credential.helper = "\${pkgs.writeShellScriptBin "git-credential-manager-windows" ''
          "/mnt/c/Program Files/Git/mingw64/bin/git-credential-manager.exe" "$@"
        ''}/bin/git-credential-manager-windows";
    programs.git.includes = [ { condition = "gitdir:~/projects/oss/"; contents.user.name = "Tony Stark"; contents.user.email = "tony@oss.example"; } ];
    xdg.configFile.nvim.source = config.lib.file.mkOutOfStoreSymlink "\${config.home.homeDirectory}/dotfiles/nvim/.config/nvim";
    xdg.configFile.nvim.recursive = true;
    xdg.configFile.eza.source = config.lib.file.mkOutOfStoreSymlink "\${config.home.homeDirectory}/dotfiles/eza/.config/eza";
    xdg.configFile.eza.recursive = true;
    xdg.configFile.lazygit.source = config.lib.file.mkOutOfStoreSymlink "\${config.home.homeDirectory}/dotfiles/lazygit/.config/lazygit";
    xdg.configFile.lazygit.recursive = true;
    xdg.configFile.yazi.source = config.lib.file.mkOutOfStoreSymlink "\${config.home.homeDirectory}/dotfiles/yazi/.config/yazi";
    xdg.configFile.yazi.recursive = true;
  };
}
",
}
`;
