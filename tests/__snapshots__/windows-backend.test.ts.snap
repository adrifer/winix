exports[`generateWindows() emitter > emits a stable configuration.winget + apply.ps1 for a windows host 1`] = `
{
  "apply.ps1": "# Generated by Winix. Do not edit.
$ErrorActionPreference = "Stop"
Set-Location -Path $PSScriptRoot

winget configure \`
    -f .\\configuration.winget \`
    --accept-configuration-agreements \`
    --disable-interactivity
",
  "configuration.winget": "# yaml-language-server: $schema=https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
# Generated by Winix for host "desktop". Do not edit.
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor: dscv3
resources:
  - name: 9NKSQGP7F2NH
    type: Microsoft.WinGet/Package
    properties:
      id: 9NKSQGP7F2NH
      source: msstore
      acceptAgreements: true
      version: "1.0.0"
  - name: "Git Git"
    type: Microsoft.WinGet/Package
    properties:
      id: Git.Git
      source: winget
      acceptAgreements: true
      version: "2.44.0"
  - name: "Microsoft VisualStudioCode"
    type: Microsoft.WinGet/Package
    properties:
      id: Microsoft.VisualStudioCode
      source: winget
      acceptAgreements: true
      version: "1.90.1"
  - name: "command 1"
    type: Microsoft.DSC.Transitional/RunCommandOnSet
    properties:
      executable: powershell
      arguments: ["-Command", "Write-Host after-packages"]
  - name: "command 2"
    type: Microsoft.DSC.Transitional/RunCommandOnSet
    properties:
      executable: pwsh
      arguments: ["-Command", "Write-Host explicit"]
  - name: "make bin dir"
    type: Microsoft.DSC.Transitional/RunCommandOnSet
    properties:
      executable: cmd
      arguments: ["/c", "mkdir", "foo"]
",
}
`;

exports[`generateWindows() emitter: dsc / env / path > emits a generic dsc resource verbatim 1`] = `
"# yaml-language-server: $schema=https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
# Generated by Winix for host "desktop". Do not edit.
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor: dscv3
resources:
  - name: "dsc 1"
    type: Microsoft.Windows/Service
    properties:
      name: spooler
      startType: automatic
"
`;

exports[`generateWindows() emitter: dsc / env / path > emits env and path as PSDSC adapter resources 1`] = `
"# yaml-language-server: $schema=https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
# Generated by Winix for host "desktop". Do not edit.
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor: dscv3
resources:
  - name: "Set EDITOR"
    type: Microsoft.DSC/PowerShell
    properties:
      resources:
      - name: EDITOR
        type: PSDscResources/Environment
        properties:
          Name: EDITOR
          Ensure: Present
          Value: nvim
          Target:
          - Process
          - Machine
  - name: "Path USERPROFILE local bin"
    type: Microsoft.DSC/PowerShell
    properties:
      resources:
      - name: Path
        type: PSDscResources/Environment
        properties:
          Name: Path
          Ensure: Present
          Value: "%USERPROFILE%\\\\.local\\\\bin"
          Path: true
          Target:
          - Process
          - Machine
"
`;

