exports[`generateWindows() emitter > emits a stable configuration.winget + apply.ps1 for a windows host 1`] = `
{
  "apply.ps1": "# Generated by Winix. Do not edit.
$ErrorActionPreference = "Stop"
Set-Location -Path $PSScriptRoot

winget configure \`
    -f .\\configuration.winget \`
    --accept-configuration-agreements \`
    --disable-interactivity
",
  "configuration.winget": "# yaml-language-server: $schema=https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
# Generated by Winix for host "desktop". Do not edit.
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor: dscv3
resources:
  - name: 9NKSQGP7F2NH
    type: Microsoft.WinGet/Package
    properties:
      id: 9NKSQGP7F2NH
      source: msstore
      acceptAgreements: true
      version: "1.0.0"
  - name: "Git Git"
    type: Microsoft.WinGet/Package
    properties:
      id: Git.Git
      source: winget
      acceptAgreements: true
      version: "2.44.0"
  - name: "Microsoft VisualStudioCode"
    type: Microsoft.WinGet/Package
    properties:
      id: Microsoft.VisualStudioCode
      source: winget
      acceptAgreements: true
      version: "1.90.1"
  - name: "command 1"
    type: Microsoft.DSC.Transitional/RunCommandOnSet
    properties:
      executable: powershell
      arguments: ["-Command", "Write-Host after-packages"]
  - name: "command 2"
    type: Microsoft.DSC.Transitional/RunCommandOnSet
    properties:
      executable: pwsh
      arguments: ["-Command", "Write-Host explicit"]
  - name: "make bin dir"
    type: Microsoft.DSC.Transitional/RunCommandOnSet
    properties:
      executable: cmd
      arguments: ["/c", "mkdir", "foo"]
",
}
`;

exports[`generateWindows() emitter: dsc / env / path > emits a generic dsc resource verbatim 1`] = `
"# yaml-language-server: $schema=https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
# Generated by Winix for host "desktop". Do not edit.
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor: dscv3
resources:
  - name: "dsc 1"
    type: Microsoft.Windows/Service
    properties:
      name: spooler
      startType: automatic
"
`;

exports[`generateWindows() emitter: dsc / env / path > emits env as Registry and path as WindowsPowerShellScript resources 1`] = `
"# yaml-language-server: $schema=https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
# Generated by Winix for host "desktop". Do not edit.
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor: dscv3
resources:
  - name: "Set EDITOR"
    type: Microsoft.Windows/Registry
    properties:
      keyPath: "HKCU\\\\Environment"
      valueName: EDITOR
      _exist: true
      valueData:
        String: nvim
  - name: "Add USERPROFILE local bin to PATH"
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: "$registryPath = 'HKCU:\\\\Environment'\\nGet-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue"
      testScript: "$dir = '%USERPROFILE%\\\\.local\\\\bin'\\n$registryPath = 'HKCU:\\\\Environment'\\n$current = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\n$entries = if ([string]::IsNullOrEmpty($current)) { @() } else { $current -split ';' }\\n$entries -contains $dir"
      setScript: "$dir = '%USERPROFILE%\\\\.local\\\\bin'\\n$registryPath = 'HKCU:\\\\Environment'\\n$target = 'User'\\n$key = Get-Item -Path $registryPath\\n$originalKind = $null\\ntry { $originalKind = $key.GetValueKind('Path') } catch { $originalKind = $null }\\n$current = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\n$entries = if ([string]::IsNullOrEmpty($current)) { @() } else { $current -split ';' }\\nif ($entries -notcontains $dir) {\\n  $new = if ([string]::IsNullOrEmpty($current)) { $dir } else { \\"$current;$dir\\" }\\n  [Environment]::SetEnvironmentVariable('Path', $new, $target)\\n}\\n$afterKey = Get-Item -Path $registryPath\\n$afterValue = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\nif ($originalKind -eq [Microsoft.Win32.RegistryValueKind]::ExpandString -and $afterKey.GetValueKind('Path') -ne [Microsoft.Win32.RegistryValueKind]::ExpandString) {\\n  Set-ItemProperty -Path $registryPath -Name 'Path' -Value $afterValue -Type ExpandString\\n}"
"
`;

exports[`generateWindows() emitter: dsc / env / path > emits scoped env and path set/remove variants 1`] = `
"# yaml-language-server: $schema=https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
# Generated by Winix for host "desktop". Do not edit.
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor: dscv3
resources:
  - name: "Set USER VAR"
    type: Microsoft.Windows/Registry
    properties:
      keyPath: "HKCU\\\\Environment"
      valueName: USER_VAR
      _exist: true
      valueData:
        String: u
  - name: "Set MACHINE VAR"
    type: Microsoft.Windows/Registry
    properties:
      keyPath: "HKLM\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\Session Manager\\\\Environment"
      valueName: MACHINE_VAR
      _exist: true
      valueData:
        String: m
  - name: "Remove OLD USER VAR"
    type: Microsoft.Windows/Registry
    properties:
      keyPath: "HKCU\\\\Environment"
      valueName: OLD_USER_VAR
      _exist: false
  - name: "Add C user bin to PATH"
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: "$registryPath = 'HKCU:\\\\Environment'\\nGet-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue"
      testScript: "$dir = 'C:\\\\user-bin'\\n$registryPath = 'HKCU:\\\\Environment'\\n$current = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\n$entries = if ([string]::IsNullOrEmpty($current)) { @() } else { $current -split ';' }\\n$entries -contains $dir"
      setScript: "$dir = 'C:\\\\user-bin'\\n$registryPath = 'HKCU:\\\\Environment'\\n$target = 'User'\\n$key = Get-Item -Path $registryPath\\n$originalKind = $null\\ntry { $originalKind = $key.GetValueKind('Path') } catch { $originalKind = $null }\\n$current = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\n$entries = if ([string]::IsNullOrEmpty($current)) { @() } else { $current -split ';' }\\nif ($entries -notcontains $dir) {\\n  $new = if ([string]::IsNullOrEmpty($current)) { $dir } else { \\"$current;$dir\\" }\\n  [Environment]::SetEnvironmentVariable('Path', $new, $target)\\n}\\n$afterKey = Get-Item -Path $registryPath\\n$afterValue = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\nif ($originalKind -eq [Microsoft.Win32.RegistryValueKind]::ExpandString -and $afterKey.GetValueKind('Path') -ne [Microsoft.Win32.RegistryValueKind]::ExpandString) {\\n  Set-ItemProperty -Path $registryPath -Name 'Path' -Value $afterValue -Type ExpandString\\n}"
  - name: "Add C machine bin to PATH"
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: "$registryPath = 'HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\Session Manager\\\\Environment'\\nGet-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue"
      testScript: "$dir = 'C:\\\\machine-bin'\\n$registryPath = 'HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\Session Manager\\\\Environment'\\n$current = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\n$entries = if ([string]::IsNullOrEmpty($current)) { @() } else { $current -split ';' }\\n$entries -contains $dir"
      setScript: "$dir = 'C:\\\\machine-bin'\\n$registryPath = 'HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\Session Manager\\\\Environment'\\n$target = 'Machine'\\n$key = Get-Item -Path $registryPath\\n$originalKind = $null\\ntry { $originalKind = $key.GetValueKind('Path') } catch { $originalKind = $null }\\n$current = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\n$entries = if ([string]::IsNullOrEmpty($current)) { @() } else { $current -split ';' }\\nif ($entries -notcontains $dir) {\\n  $new = if ([string]::IsNullOrEmpty($current)) { $dir } else { \\"$current;$dir\\" }\\n  [Environment]::SetEnvironmentVariable('Path', $new, $target)\\n}\\n$afterKey = Get-Item -Path $registryPath\\n$afterValue = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\nif ($originalKind -eq [Microsoft.Win32.RegistryValueKind]::ExpandString -and $afterKey.GetValueKind('Path') -ne [Microsoft.Win32.RegistryValueKind]::ExpandString) {\\n  Set-ItemProperty -Path $registryPath -Name 'Path' -Value $afterValue -Type ExpandString\\n}"
  - name: "Remove C old user bin from PATH"
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: "$registryPath = 'HKCU:\\\\Environment'\\nGet-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue"
      testScript: "$dir = 'C:\\\\old-user-bin'\\n$registryPath = 'HKCU:\\\\Environment'\\n$current = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\n$entries = if ([string]::IsNullOrEmpty($current)) { @() } else { $current -split ';' }\\n-not ($entries -contains $dir)"
      setScript: "$dir = 'C:\\\\old-user-bin'\\n$registryPath = 'HKCU:\\\\Environment'\\n$target = 'User'\\n$key = Get-Item -Path $registryPath\\n$originalKind = $null\\ntry { $originalKind = $key.GetValueKind('Path') } catch { $originalKind = $null }\\n$current = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\n$entries = if ([string]::IsNullOrEmpty($current)) { @() } else { $current -split ';' }\\nif ($entries -contains $dir) {\\n  $new = ($entries | Where-Object { $_ -ne $dir }) -join ';'\\n  [Environment]::SetEnvironmentVariable('Path', $new, $target)\\n}\\n$afterKey = Get-Item -Path $registryPath\\n$afterValue = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\nif ($originalKind -eq [Microsoft.Win32.RegistryValueKind]::ExpandString -and $afterKey.GetValueKind('Path') -ne [Microsoft.Win32.RegistryValueKind]::ExpandString) {\\n  Set-ItemProperty -Path $registryPath -Name 'Path' -Value $afterValue -Type ExpandString\\n}"
"
`;

exports[`winix-windows.lock > writes deterministic JSON with sorted package keys 1`] = `
"{
  "version": 1,
  "generatedAt": "2026-06-24T18:37:00.000Z",
  "packages": {
    "Git.Git": {
      "source": "winget",
      "version": "2.44.0",
      "resolvedAt": "2026-06-24T18:37:00.000Z"
    },
    "ZedIndustries.Zed": {
      "source": "winget",
      "version": "0.190.0",
      "resolvedAt": "2026-06-24T18:37:00.000Z"
    }
  }
}
"
`;
