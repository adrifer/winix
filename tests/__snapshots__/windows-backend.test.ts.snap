      "source": "winget",
      "version": "2.44.0",
      "resolvedAt": "2026-06-24T18:37:00.000Z"
    },
    "ZedIndustries.Zed": {
      "source": "winget",
      "version": "0.190.0",
      "resolvedAt": "2026-06-24T18:37:00.000Z"
    }
  }
}
"
`;
