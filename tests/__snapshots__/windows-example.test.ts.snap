// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`windows example integration > generates stable Windows output for examples/windows 1`] = `
{
  "apply.ps1": "# Generated by Winix. Do not edit.
$ErrorActionPreference = "Stop"
Set-Location -Path $PSScriptRoot

winget configure \`
    -f .\\configuration.winget \`
    --accept-configuration-agreements \`
    --disable-interactivity
",
  "configuration.winget": "# yaml-language-server: $schema=https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
# Generated by Winix for host "desktop". Do not edit.
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor: dscv3
resources:
  - name: "Fastfetch cli Fastfetch"
    type: Microsoft.WinGet/Package
    properties:
      id: Fastfetch-cli.Fastfetch
      source: winget
      acceptAgreements: true
      version: "2.65.1"
  - name: "eza community eza"
    type: Microsoft.WinGet/Package
    properties:
      id: eza-community.eza
      source: winget
      acceptAgreements: true
      version: "0.23.4"
  - name: "Set EDITOR"
    type: Microsoft.Windows/Registry
    properties:
      keyPath: "HKCU\\\\Environment"
      valueName: EDITOR
      _exist: true
      valueData:
        String: nvim
  - name: "Add USERPROFILE local bin to PATH"
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: "$registryPath = 'HKCU:\\\\Environment'\\nGet-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue"
      testScript: "$dir = '%USERPROFILE%\\\\.local\\\\bin'\\n$registryPath = 'HKCU:\\\\Environment'\\n$current = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\n$entries = if ([string]::IsNullOrEmpty($current)) { @() } else { $current -split ';' }\\n$entries -contains $dir"
      setScript: "$dir = '%USERPROFILE%\\\\.local\\\\bin'\\n$registryPath = 'HKCU:\\\\Environment'\\n$target = 'User'\\n$key = Get-Item -Path $registryPath\\n$originalKind = $null\\ntry { $originalKind = $key.GetValueKind('Path') } catch { $originalKind = $null }\\n$current = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\n$entries = if ([string]::IsNullOrEmpty($current)) { @() } else { $current -split ';' }\\nif ($entries -notcontains $dir) {\\n  $new = if ([string]::IsNullOrEmpty($current)) { $dir } else { \\"$current;$dir\\" }\\n  [Environment]::SetEnvironmentVariable('Path', $new, $target)\\n}\\n$afterKey = Get-Item -Path $registryPath\\n$afterValue = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\nif ($originalKind -eq [Microsoft.Win32.RegistryValueKind]::ExpandString -and $afterKey.GetValueKind('Path') -ne [Microsoft.Win32.RegistryValueKind]::ExpandString) {\\n  Set-ItemProperty -Path $registryPath -Name 'Path' -Value $afterValue -Type ExpandString\\n}"
  - name: "Set CARGO HOME"
    type: Microsoft.Windows/Registry
    properties:
      keyPath: "HKCU\\\\Environment"
      valueName: CARGO_HOME
      _exist: true
      valueData:
        String: "%USERPROFILE%\\\\.cargo"
  - name: "Add CARGO HOME bin to PATH"
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    dependsOn: ["[resourceId('Microsoft.Windows/Registry', 'Set CARGO HOME')]"]
    properties:
      getScript: "$registryPath = 'HKCU:\\\\Environment'\\nGet-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue"
      testScript: "$dir = '%CARGO_HOME%\\\\bin'\\n$registryPath = 'HKCU:\\\\Environment'\\n$current = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\n$entries = if ([string]::IsNullOrEmpty($current)) { @() } else { $current -split ';' }\\n$entries -contains $dir"
      setScript: "$dir = '%CARGO_HOME%\\\\bin'\\n$registryPath = 'HKCU:\\\\Environment'\\n$target = 'User'\\n$key = Get-Item -Path $registryPath\\n$originalKind = $null\\ntry { $originalKind = $key.GetValueKind('Path') } catch { $originalKind = $null }\\n$current = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\n$entries = if ([string]::IsNullOrEmpty($current)) { @() } else { $current -split ';' }\\nif ($entries -notcontains $dir) {\\n  $new = if ([string]::IsNullOrEmpty($current)) { $dir } else { \\"$current;$dir\\" }\\n  [Environment]::SetEnvironmentVariable('Path', $new, $target)\\n}\\n$afterKey = Get-Item -Path $registryPath\\n$afterValue = Get-ItemPropertyValue -Path $registryPath -Name 'Path' -ErrorAction SilentlyContinue\\nif ($originalKind -eq [Microsoft.Win32.RegistryValueKind]::ExpandString -and $afterKey.GetValueKind('Path') -ne [Microsoft.Win32.RegistryValueKind]::ExpandString) {\\n  Set-ItemProperty -Path $registryPath -Name 'Path' -Value $afterValue -Type ExpandString\\n}"
",
}
`;
