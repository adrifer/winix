// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`windows example integration > generates stable Windows output for examples/windows 1`] = `
{
  "resources.json": "{
  "host": "desktop",
  "resources": [
    {
      "name": "Fastfetch cli Fastfetch",
      "type": "winget/package",
      "category": "package",
      "label": "Fastfetch-cli.Fastfetch",
      "elevated": false,
