{
  "name": "winix",
  "version": "0.1.0",
  "description": "TypeScript-first system configuration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./types/bundled": {
      "types": "./types/index.d.ts"
    }
  },
  "bin": {
    "winix": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "types/bundled",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-dts-imports.mjs",
    "dev": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src/",
    "check": "tsc --noEmit",
    "prepack": "npm run build",
    "generate:types": "npx tsx scripts/generate-types.ts",
    "generate:types:nixos": "npx tsx scripts/generate-types.ts nixos",
    "generate:types:hm": "npx tsx scripts/generate-types.ts home-manager",
    "generate:types:darwin": "npx tsx scripts/generate-types.ts darwin"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
