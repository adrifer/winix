{
  "name": "@adrifer/winix",
  "version": "0.2.0",
  "description": "TypeScript-first system configuration for NixOS, nix-darwin, and Home Manager",
  "license": "MIT",
  "author": "Adrian Fernandez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrifer/winix.git"
  },
  "bugs": {
    "url": "https://github.com/adrifer/winix/issues"
  },
  "homepage": "https://github.com/adrifer/winix#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nix",
    "nixos",
    "nix-darwin",
    "home-manager",
    "typescript",
    "configuration"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./types/bundled": {
      "types": "./types/index.d.ts"
    }
  },
  "bin": {
    "winix": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "types",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/fix-dts-imports.mjs",
    "dev": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src/",
    "check": "tsc --noEmit",
    "prepack": "npm run build",
    "release:stable": "node scripts/release.mjs stable",
    "release:preview": "node scripts/release.mjs preview",
    "generate:types": "npx tsx scripts/generate-types.ts",
    "generate:types:nixos": "npx tsx scripts/generate-types.ts nixos",
    "generate:types:hm": "npx tsx scripts/generate-types.ts home-manager",
    "generate:types:darwin": "npx tsx scripts/generate-types.ts darwin"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
